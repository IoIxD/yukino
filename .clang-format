---
Language: Cpp
#   don't see this documented anywhere nor do I think it matters.
#   C grammar hasn't changed much since C99.
#Standard: c99
BasedOnStyle: LLVM
UseTab: ForContinuationAndIndentation
PointerAlignment: Right
ColumnLimit: 80
# NOTE we actually use 8 for all three of these values, but I have
# lowered it to 4 to work around a bug regarding if-statement
# conditional indentation
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 4
PPIndentWidth: 1

IndentCaseLabels: false
IndentAccessModifiers: false
IndentPPDirectives: AfterHash

BreakBeforeBraces: WebKit
BreakStringLiterals: false

AlwaysBreakTemplateDeclarations: true

SpaceAfterTemplateKeyword: false

AlignAfterOpenBracket: DontAlign

AlignArrayOfStructures: Left
AlignEscapedNewlines: DontAlign
AlignConsecutiveMacros: true
AlignOperands: DontAlign

AllowShortIfStatementsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty
AllowShortEnumsOnASingleLine: true
AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortCaseLabelsOnASingleLine: true

BreakBeforeTernaryOperators: true

QualifierAlignment: Left

SpacesBeforeTrailingComments: 1
# SpacesInBlockComments: Leave

#  don't touch this
SpacesInLineCommentPrefix:
  Minimum: 0
  Maximum: -1

BreakBeforeBinaryOperators: All

InsertNewlineAtEOF: true

IndentGotoLabels: false

IndentWrappedFunctionNames: false

# I know better than you do
AlignTrailingComments: Leave

IncludeCategories:
  - Regex: '^"yukino\.h"$'
    Priority: -1
